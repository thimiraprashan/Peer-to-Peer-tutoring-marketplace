rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Merge with your existing rules in Firebase Console if other collections are already defined.

    match /favourites/{favouriteId} {
      allow read: if request.auth != null
        && resource.data.studentId == request.auth.uid;
      allow create, update: if request.auth != null
        && request.resource.data.studentId == request.auth.uid
        && favouriteId == request.auth.uid + '_' + request.resource.data.tutorId
        && request.resource.data.tutorId is string;
      allow delete: if request.auth != null
        && resource.data.studentId == request.auth.uid;
    }

    match /savedModules/{moduleId} {
      allow read: if request.auth != null
        && resource.data.studentId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.studentId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.studentId == request.auth.uid;
    }
  }
}
